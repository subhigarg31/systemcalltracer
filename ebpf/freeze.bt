#!/usr/bin/env bpftrace
BEGIN
{
	printf("{\"event\":\"armed\",\"rule\":\"4 writes in 5s\",\"dir\":\"/tmp/ransom_test\"}\n");
}

tracepoint:syscalls:sys_enter_openat
/ strncmp(str(args->filename), "/tmp/ransom_test/", 17) == 0
  && (args->flags & 3) != 0 && @frozen[pid] == 0 /
{
	if (@start[pid] == 0 || nsecs - @start[pid] > 5000000000) {
		@start[pid] = nsecs;
		@count[pid] = 0;
	}
	@count[pid]++;
	if (@count[pid] >= 4) {
		signal("SIGSTOP");
		@frozen[pid] = 1;
		printf("{\"event\":\"frozen\",\"pid\":%d,\"process\":\"%s\",\"files_in_window\":%d,\"last_file\":\"%s\",\"action\":\"SIGSTOP\"}\n",
		       pid, comm, @count[pid], str(args->filename));
	}
}
END { clear(@start); clear(@count); clear(@frozen); }
